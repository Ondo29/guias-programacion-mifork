\f2\u-10179?\u-8905?\f7  \f2 Ejemplo\f6  \f2 en\f6  \f2 Java\par
\f6 // \f2 Clase\f6  \f2 base\par
class\f6  \f2 Soldado\f6  \{\f2\par
