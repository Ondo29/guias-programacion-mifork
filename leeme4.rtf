\f5\u-10180?\u-8229?\u-497?\f7  \f6 Clase Departamento\par
\f2\u-10179?\u-8903?\f7  \f6 Invariantes clave:\par
M\'e1ximo 50 profesores\par
Siempre hay un director\par
El director SIEMPRE est\'e1 en la lista de profesores\par
No se puede eliminar al director sin reemplazarlo antes\par
class Departamento \{\par
\par
    private static final int MAX = 50;\par
\par
    private Profesor[] profesores = new Profesor[MAX];\par
    private int numProfesores = 0;\par
\par
    private Profesor director;\par
\par
    // \f2\u-10179?\u-8908?\f7  \f6 Constructor: exige director inicial\par
    public Departamento(Profesor director) \{\par
        if (director == null) \{\par
            throw new IllegalArgumentException("El director no puede ser null");\par
        \}\par
\par
        this.director = director;\par
        a\'f1adirProfesor(director); // invariante garantizada desde el inicio\par
    \}\par
\f4\u10133?\f7  \f6 A\'f1adir profesor\par
    public void a\'f1adirProfesor(Profesor p) \{\par
        if (p == null) \{\par
            throw new IllegalArgumentException("Profesor null");\par
        \}\par
\par
        if (numProfesores >= MAX) \{\par
            throw new IllegalStateException("Departamento lleno");\par
        \}\par
\par
        // Evitar duplicados simples\par
        if (contiene(p)) return;\par
\par
        profesores[numProfesores++] = p;\par
    \}\par
\f4\u10060?\f7  \f6 Eliminar profesor por posici\'f3n\par
\par
\f5\u9888?\u-497?\f7  \f6 No se puede eliminar al director sin m\'e1s.\par
\par
    public void eliminarProfesor(int index) \{\par
        validarIndice(index);\par
\par
        Profesor aEliminar = profesores[index];\par
\par
        // Invariante cr\'edtica\par
        if (aEliminar == director) \{\par
            throw new IllegalStateException(\par
                "No se puede eliminar al director sin cambiarlo antes"\par
            );\par
        \}\par
\par
        desplazarIzquierda(index);\par
    \}\par
\f2\u-10179?\u-8956?\f7  \f6 Cambiar director\par
\par
\f4\u10004?\f7  \f6 Debe ser un profesor del departamento\par
\par
    public void cambiarDirector(Profesor nuevoDirector) \{\par
        if (nuevoDirector == null) \{\par
            throw new IllegalArgumentException("Director null");\par
        \}\par
\par
        if (!contiene(nuevoDirector)) \{\par
            throw new IllegalStateException(\par
                "El director debe pertenecer al departamento"\par
            );\par
        \}\par
\par
        this.director = nuevoDirector;\par
    \}\par
\f2\u-10179?\u-9014?\f7  \f6 Acceso controlado a la lista\par
    public int numeroProfesores() \{\par
        return numProfesores;\par
    \}\par
\par
    public Profesor getProfesor(int index) \{\par
        validarIndice(index);\par
        return profesores[index];\par
    \}\par
\par
    public Profesor getDirector() \{\par
        return director;\par
    \}\par
\f2\u-10179?\u-8921?\f7  \f6 M\'e9todos auxiliares (privados)\par
    private boolean contiene(Profesor p) \{\par
        for (int i = 0; i < numProfesores; i++) \{\par
            if (profesores[i].equals(p)) return true;\par
        \}\par
        return false;\par
    \}\par
\par
    private void validarIndice(int index) \{\par
        if (index < 0 || index >= numProfesores) \{\par
            throw new IndexOutOfBoundsException("\'cdndice inv\'e1lido");\par
        \}\par
    \}\par
\par
    private void desplazarIzquierda(int index) \{\par
        for (int i = index; i < numProfesores - 1; i++) \{\par
            profesores[i] = profesores[i + 1];\par
        \}\par
        profesores[--numProfesores] = null;\par
\par
