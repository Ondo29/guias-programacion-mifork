    \}\par
\}\par
\f5\u-10180?\u-8229?\u-497?\f7  \f6 Departamento\par
import java.util.ArrayList;\par
import java.util.List;\par
\par
class Departamento \{\par
\par
    private List<Profesor> profesores = new ArrayList<>();\par
    private Profesor director;\par
\par
    // \f2\u-10179?\u-8908?\f7  \f6 Siempre debe haber director\par
    public Departamento(Profesor director) \{\par
        if (director == null) \{\par
            throw new IllegalArgumentException("El director no puede ser null");\par
        \}\par
\par
        this.director = director;\par
        profesores.add(director); // invariante inicial\par
    \}\par
\par
    // \f4\u10133?\f7  \f6 a\'f1adir profesor\par
    public void a\'f1adirProfesor(Profesor p) \{\par
        if (p == null) \{\par
            throw new IllegalArgumentException("Profesor null");\par
        \}\par
\par
        if (!profesores.contains(p)) \{\par
            profesores.add(p);\par
        \}\par
    \}\par
\par
    // \f4\u10060?\f7  \f6 eliminar por posici\'f3n\par
    public void eliminarProfesor(int pos) \{\par
        validarPos(pos);\par
\par
        Profesor p = profesores.get(pos);\par
\par
        if (p == director) \{\par
            throw new IllegalStateException(\par
                "No se puede eliminar al director sin cambiarlo antes"\par
            );\par
        \}\par
\par
        profesores.remove(pos);\par
    \}\par
\par
    // \f2\u-10179?\u-8956?\f7  \f6 cambiar director\par
    public void cambiarDirector(Profesor nuevoDirector) \{\par
        if (nuevoDirector == null) \{\par
            throw new IllegalArgumentException("Director null");\par
        \}\par
\par
        if (!profesores.contains(nuevoDirector)) \{\par
            throw new IllegalStateException(\par
                "El director debe pertenecer al departamento"\par
            );\par
        \}\par
\par
        this.director = nuevoDirector;\par
    \}\par
\par
    // \f2\u-10179?\u-9014?\f7  \f6 acceso\par
    public int numeroProfesores() \{\par
        return profesores.size();\par
    \}\par
\par
    public Profesor getProfesor(int pos) \{\par
        validarPos(pos);\par
        return profesores.get(pos);\par
    \}\par
\par
    public Profesor getDirector() \{\par
        return director;\par
    \}\par
\par
    private void validarPos(int pos) \{\par
        if (pos < 0 || pos >= profesores.size()) \{\par
            throw new IndexOutOfBoundsException("Posici\'f3n inv\'e1lida");\par
        \}\par
    \}\par
\}\par
